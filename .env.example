# Copy this file to ".env" and fill in your keys.

# OpenAI-compatible API key (works with OpenAI, Groq, Together, Ollama, etc.)
OPENAI_API_KEY=sk-your-key-here

# Optional: override the model. Default is gpt-4o.
LLM_MODEL=gpt-4o

# Optional: override the base URL for a different OpenAI-compatible provider
# OPENAI_BASE_URL=https://api.openai.com/v1
